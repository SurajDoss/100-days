/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
 
class Solution {
    class _Pair{
        int level;
        TreeNode node;

        public _Pair( int level, TreeNode node ){
            this.level = level;
            this.node = node;
        }
    }

    public List<Integer> rightSideView(TreeNode root) {
        List<Integer> rtView = new ArrayList<>();
        Queue<_Pair> order = new LinkedList<>();

        _Pair pair = new _Pair( 1, root );
        order.offer(pair);

        int isRightLevel = 0;

        while( !order.isEmpty() ){
            pair = order.poll();
            TreeNode node = pair.node;
            int level = pair.level;

            if( node == null ){
                break;
            }

            if(isRightLevel != level){
                rtView.add( node.val );
                isRightLevel = level;
            }


            if( node.right != null ){
                order.offer( new _Pair( level + 1,  node.right) );
            }

            if( node.left != null ){
                order.offer(new _Pair( level + 1, node.left) );
            }

        }
        return rtView;
    }
}
