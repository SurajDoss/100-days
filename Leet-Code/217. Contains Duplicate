class Solution {
    public boolean containsDuplicate(int[] nums) {
        int length = nums.length;
        Set<Integer> list = new HashSet<Integer>(Math.max(16, (int)(length / 0.75f) + 1));
        for(Integer num : nums){
            if(!list.add(num)){
                return true;
            }
        }
        return false;
    }
}
