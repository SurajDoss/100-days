class Solution {
    public int majorityElement(int[] nums) {
        HashMap<Integer, Integer> counter = new HashMap<Integer, Integer>();
        int numsLength = nums.length;

        for(int i =0; i < numsLength; i++){
            counter.put(nums[i], counter.getOrDefault(nums[i], 0) + 1);
        }

        int moreThanHalf = numsLength / 2 ; 
        
        for(Integer mapKey : counter.keySet()){
            if(counter.get(mapKey) > moreThanHalf){
                return mapKey;
            }
        }

        return 0;
    }

    public int majorityElement1(int[] nums) {
        Map<Integer, Integer> feqNumberMap = new HashMap<Integer, Integer>();
        int length = nums.length;
        int pointer = 0;

        while( pointer < length){
            feqNumberMap.put(nums[pointer], feqNumberMap.getOrDefault( nums[pointer] , 0 ) + 1);
            pointer++;
        }

        Integer majority = length / 2 ;
        for( Integer number : feqNumberMap.keySet() ){
            if(feqNumberMap.get(number) > majority){
                return number;
            }
        }
        return 0;
    }

    /**
    * Boyer moores voting agorithm, faster and o(1) space comp
    */
   public int majorityElement(int[] nums) {
        int counter = 0;
        Integer candidate = null;

        for(int number : nums){
            if( counter == 0 ){
                candidate = number;
            }
            counter += ( candidate == number ) ? +1 : -1 ;
        }
        return candidate;
    }
}
