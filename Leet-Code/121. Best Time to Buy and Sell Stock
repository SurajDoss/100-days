class Solution {
    public int maxProfit(int[] prices) {
        Integer currentPrice = prices[0];
        Integer maxProfit = 0;

        for(int i = 1; i < prices.length; i++){
            if(currentPrice < prices[i]){
                maxProfit = Math.max( ( prices[i] - currentPrice) ,  maxProfit);
            }else{
               currentPrice = prices[i];
            }
        }
        return maxProfit;
    }

    public int maxProfitAnother(int[] prices) {
        Integer min = Integer.MAX_VALUE;
        Integer maxProfits = 0;
        int len = prices.length;

        for( int i = 0; i < len; i++){
            if( prices[i] < min ){
                min = prices[i];
            }
            int currentDayProfit = prices[i] - min;
            if( maxProfits < currentDayProfit ){
                maxProfits = currentDayProfit;
            }

        }
        return maxProfits;
    }
}
