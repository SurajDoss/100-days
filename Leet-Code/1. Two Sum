class Solution {
    public int[] twoSum(int[] nums, int target) {
        int arryLength = nums.length;
        /**
        * we iterate the i till the last index - 1, so that j will go till last index
        * the for the j start index should be i + 1, because j point should always start from the index of i + 1.
        * we return empty array if the length is not forun
        */
        for(int i = 0; i < arryLength - 1; i++ ){
            for(int j = i + 1; j < arryLength; j++){
                if( nums[i] + nums[j] == target){
                    return new int[] {i, j};
                }
            }

        }
        return new int[] {};
    }

  public int[] twoSum(int[] nums, int target) {
        int length = nums.length;
        Map<Integer, Integer> valuesVsIndex = new HashMap<Integer, Integer>();

        for(int i = 0; i < length; i++){
            /**
            * we iterate the i till the last, so that we can find the two index.
            * always target = i + j, so, target - i = j. we need to find that j by cutting a iteration.
            * put the (num[i], i) in the hashMap. to check the j
            */
            int subOfNum = target - nums[i];
            if( valuesVsIndex.containsKey( subOfNum ) ){
                return new int[] { valuesVsIndex.get( subOfNum ), i };
            }
            valuesVsIndex.put( nums[i], i);
        }
        return new int[] {};
    }
}
