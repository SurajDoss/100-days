class Solution {
    public int removeDuplicates(int[] nums) {
        int length = nums.length;
        if(length< 2){
            return length;
        }

        int counter = 2;
        for(int i = 2 ; i < length; i++){
            if(nums[i] != nums[counter-2]){
                nums[counter] = nums[i];
                counter++;
            }
        }

        return counter;
    }

    public int removeDuplicatesAnother(int[] nums) {
        int counter = 0;

        for(int num : nums){
            if( counter < 2 || nums[counter - 2] != num){
                nums[counter] = num;
                counter++;
            }
        }
        return counter;
    }
}
