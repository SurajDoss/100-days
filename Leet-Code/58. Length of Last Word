class Solution {
 public int lengthOfLastWord(String s) {
        s = s.trim();
        int lastIndex = s.length() - 1;
        int counter = 0;

        while( lastIndex >= 0 ){
            if( s.charAt( lastIndex ) == ' ' ){
                break;
            }else{
                counter++;
                lastIndex--;
            }
        }

        return counter;
    }
}
