class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        int maxCandies = 0;
        int candiesLen = candies.length;
        for(int i = 0; i < candiesLen; i++){
            maxCandies = Math.max(candies[i], maxCandies);
        } 

        ArrayList<Boolean> areMaxCandies = new ArrayList<Boolean>();
        for(int i = 0; i < candiesLen; i++){
            if( ( candies[i] + extraCandies ) >= maxCandies){
                areMaxCandies.add(Boolean.TRUE);
            }else{
                areMaxCandies.add(Boolean.FALSE);
            }
        }

        return areMaxCandies;
    }
}
